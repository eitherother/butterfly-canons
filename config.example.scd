// Local machine paths, shared across all pieces.
//
// Copy this file to config.scd (at the repo root) and fill in your own
// values. config.scd is gitignored — never commit it. Pieces load it
// automatically from their init.scd before referencing any of these.
(
~sampleLibraryRoot = "/path/to/your/SoundFiles/";
~recordDir = "/path/to/your/recordings/";
)
